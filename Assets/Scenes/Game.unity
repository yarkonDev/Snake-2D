  message: "\u0417\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442 \u0437\u043C\u0435\u0439\u043A\u0443
    \u043D\u0430 75% \u043E\u0442 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
    \u043D\u0430 5 \u0441\u0435\u043A\u0443\u043D\u0434. \u0410\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u043F\u043E \u043D\u0430\u0436\u0430\u0442\u0438\u044E \u0438\u043A\u043E\u043D\u043A\u0438
